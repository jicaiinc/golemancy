{
  "name": "golemancy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "dev:desktop": "pnpm --filter @golemancy/desktop tauri:dev",
    "build:desktop": "pnpm --filter @golemancy/desktop tauri:build",
    "sidecar:dev": "pnpm --filter @golemancy/sidecar dev:serve"
  },
  "devDependencies": {
    "@lingui/cli": "^5.9.5",
    "@lingui/format-po": "^5.9.5",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
