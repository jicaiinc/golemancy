{
  "name": "@golemancy/i18n",
  "version": "0.2.0-rebuild.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "extract": "i18next --config ../../i18next-parser.config.ts",
    "clean": "rimraf .turbo .tsbuildinfo"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "react-i18next": "^15.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "i18next-parser": "^9.3.0",
    "react": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
