{
  "name": "@golemancy/sidecar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev:serve": "tsx src/main.ts",
    "native-host": "tsx src/native-host.ts",
    "build": "tsup src/main.ts src/index.ts src/native-host.ts --format esm --platform=node --target=node24 --out-dir dist --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@golemancy/db": "workspace:*",
    "@golemancy/protocol": "workspace:*",
    "@golemancy/runtime": "workspace:*",
    "@golemancy/shared": "workspace:*",
    "@hono/node-server": "^1.19.7",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8"
  }
}
