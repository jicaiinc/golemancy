{
  "name": "@golemancy/sidecar",
  "version": "0.2.0-rebuild.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "golemancy-sidecar": "./bin/sidecar.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "clean": "rimraf .turbo .tsbuildinfo"
  },
  "dependencies": {
    "@golemancy/db": "workspace:*",
    "@golemancy/protocol": "workspace:*",
    "@golemancy/runtime": "workspace:*",
    "@golemancy/shared": "workspace:*",
    "@golemancy/tools": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
