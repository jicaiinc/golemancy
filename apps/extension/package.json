{
  "name": "@golemancy/extension",
  "version": "0.2.0-rebuild.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "clean": "rimraf .turbo .output .wxt"
  },
  "dependencies": {
    "@golemancy/protocol": "workspace:*",
    "@golemancy/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.290",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "wxt": "^0.19.27"
  }
}
