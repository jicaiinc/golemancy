# Desktop OAuth Bridge — local dev overrides
#
# Copy to `.env.local` (gitignored) and uncomment to point the desktop app
# at a locally running golemancy_platform (apps/web on :3000, apps/runtime on :8080).
# Leave unset to hit the production stack (www.golemancy.ai / runtime.golemancy.ai).
#
# Vite (frontend, import.meta.env) — consumed by packages/ui provider-presets
# VITE_GOLEMANCY_WEB_URL=http://127.0.0.1:3000
# VITE_GOLEMANCY_RUNTIME_URL=http://127.0.0.1:8080
#
# Node (backend, process.env) — consumed by packages/server OAuth provider config
# GOLEMANCY_WEB_URL=http://127.0.0.1:3000
# GOLEMANCY_RUNTIME_URL=http://127.0.0.1:8080
